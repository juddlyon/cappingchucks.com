---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import measurementCaliper from '../assets/images/measurement-caliper.jpg';

const problems = [
    {
        id: 'scuffing',
        title: 'Scuffed caps',
        why: 'The chuck squeezes too hard, or its opening is off-center. The cap rubs against the grip ridges as it turns.',
        fix: 'Lower the grip pressure or replace a worn insert. The chuck opening should match the cap width within &plusmn;0.15 mm. Replace a scuffed urethane liner.',
    },
    {
        id: 'uneven-torque',
        title: 'Uneven torque (high CV%)',
        why: 'Worn clutch plates, a dirty magnetic disc, or air pressure that jumps around. Caps or bottle necks that are out of spec also cause it.',
        fix: 'Replace clutch plates or clean the magnetic unit. Check air pressure matches the machine spec (often 6.0 bar &plusmn;0.2 bar) and that the moisture trap works. If torque still varies, run a Cpk study on incoming caps and bottles.',
    },
    {
        id: 'te-bands',
        title: 'Broken tamper bands',
        why: 'Too much torque. The cap turns past the point where the band\'s small plastic <a href="/glossary/#bridge-count">bridges</a> break. The band snaps during capping instead of when the customer opens it.',
        fix: 'Lower torque by 10 to 15%. Check the bridge count and thickness against the cap spec. Check the chuck for wobble (runout) that pushes down unevenly.',
    },
    {
        id: 'cross-threading',
        title: 'Cross-threading',
        why: 'The cap is not centered on the bottle before it starts turning. Causes: worn guide rails, chuck set at the wrong height, or the cap feed dropping caps.',
        fix: 'Check how far the chuck comes down and where it first touches the cap. Look for wear on the centering bell. Make sure the bottle neck tilts less than 1&deg;, per the bottle drawing.',
    },
    {
        id: 'vacuum-loss',
        title: 'Lost vacuum after capping',
        why: 'Not enough torque to press the seal fully. It can also be a damaged liner or a chipped or out-of-round bottle neck.',
        fix: 'Raise torque in 0.2 N&middot;m steps until headspace vacuum meets spec. Check the bottle\'s sealing surface with go/no-go gauges.',
    },
    {
        id: 'undertorque',
        title: 'Caps too loose (undertorque)',
        why: 'The clutch slips too early. Causes: worn friction plates, a weak spring, or a failing magnet coil. Oil or dirt on the clutch also makes it slip.',
        fix: 'Replace the clutch disc and spring. Clean all contact surfaces. On <a href="/capping-headsets/#magnetic">magnetic units</a>, check coil resistance and current draw against spec. Check every spindle, not just one.',
    },
];
---

<BaseLayout
    title="Capping Troubleshooting and Headset Calibration Guide"
    description="Fix common capping problems: scuffed caps, uneven torque, broken tamper bands, cross-threading, lost vacuum, and loose caps. Plus step-by-step capper headset calibration."
    canonical="https://cappingchucks.com/troubleshooting/"
    ogTitle="Capping Troubleshooting and Calibration | CappingChucks.com"
    ogDescription="Causes and fixes for common capping line problems, plus how to calibrate a capper headset step by step."
    schemaType="TechArticle"
    breadcrumb="Troubleshooting"
>
    <PageHero
        title="Capping Troubleshooting and Calibration"
        crumb="Troubleshooting"
        answerLabel="Start here"
        image={measurementCaliper}
        alt="Mitutoyo digital caliper measuring steel beam width for dimensional verification"
        caption="Checking a part size with a digital caliper. Photo: Pexels"
    >
        <p>Most capping problems come from one of three things: torque set wrong, worn <a href="/chuck-types/">chuck</a> or <a href="/capping-headsets/">headset</a> parts, or caps and bottles that are out of spec. Find your problem below, then check the fix.</p>
    </PageHero>

    <main>
        <section id="problems" class="section">
            <div class="wrap">
                <span class="kicker">Problems</span>
                <h2>Common capping problems and fixes</h2>
                <div class="cards cards-2">
                    {problems.map((p) => (
                        <div class="card problem" id={p.id}>
                            <h3>{p.title}</h3>
                            <dl>
                                <dt class="why">Why it happens</dt>
                                <dd set:html={p.why} />
                                <dt class="fix">How to fix it</dt>
                                <dd set:html={p.fix} />
                            </dl>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section id="calibration" class="section section-alt">
            <div class="wrap">
                <span class="kicker kicker-green">Calibration</span>
                <h2>How to calibrate a capper headset</h2>
                <p class="lead prose-col">Do this after any clutch or insert change, and on your plant's regular audit schedule. Faster lines need more frequent checks.</p>
                <div class="grid gap-8 md:grid-cols-2 items-start">
                    <ol class="steps">
                        <li>Get the target application torque from the cap maker's spec for your exact cap and liner.</li>
                        <li>Set the torque. On a <a href="/capping-headsets/#spring-clutch">spring-clutch headset</a>, turn the threaded collar or change shims. On a <a href="/capping-headsets/#magnetic">magnetic headset</a>, change the DC current to the coil.</li>
                        <li>Run at least 30 bottles, or the number your validation plan calls for.</li>
                        <li>Test each cap with a calibrated torque tester, using a written method.</li>
                        <li>Work out the spread (<a href="/glossary/#cv">CV%</a>). Aim for 5% or less. Fast rotary lines aim for 3% or less.</li>
                        <li>If the spread is too high, look for worn clutch parts, play in the spindle connection, or out-of-spec caps.</li>
                        <li>Check every spindle on the turret, not just one, and write down the results.</li>
                    </ol>
                    <div class="specs">
                        <p class="specs-title">Calibration numbers</p>
                        <div class="spec-row"><span class="spec-label">Sample size</span><span class="spec-value">30+ caps</span></div>
                        <div class="spec-row"><span class="spec-label">CV% target</span><span class="spec-value">&le; 5% standard, &le; 3% fast rotary</span></div>
                        <div class="spec-row"><span class="spec-label">Torque tester</span><span class="spec-value">Calibrated, with a written method</span></div>
                        <div class="spec-row"><span class="spec-label">Rules to follow</span><span class="spec-value">Cap maker, customer, and regulations (see <a href="https://store.astm.org/d2063_d2063m-24.html" rel="noopener" target="_blank">ASTM D2063</a>)</span></div>
                    </div>
                </div>
                <div class="note prose-col">
                    <strong>Remember:</strong> Torque drops after capping as the liner settles. Removal torque tested later is often 10 to 30% lower than the torque applied. See <a href="/glossary/#static-torque">static torque</a>.
                </div>
            </div>
        </section>

        <section class="section">
            <div class="wrap">
                <h2>Keep reading</h2>
                <ul class="related">
                    <li><a href="/chuck-types/">Capping chuck types</a></li>
                    <li><a href="/capping-headsets/">Magnetic capping headsets</a></li>
                    <li><a href="/glossary/">Glossary</a></li>
                </ul>
            </div>
        </section>
    </main>
</BaseLayout>
