---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import technicalBlueprint from '../assets/images/technical-blueprint.jpg';

const terms = [
    { id: 'capping-chuck', term: 'Capping Chuck', def: 'The part of a capping machine that grips a cap and screws it onto a bottle. It sits at the bottom of a spinning spindle. See <a href="/">capping chucks</a>.' },
    { id: 'capping-headset', term: 'Capping Headset (Capping Head)', def: 'The full unit on a spindle: the chuck, the clutch that controls torque, and the spindle adapter. See <a href="/capping-headsets/">magnetic capping headsets</a>.' },
    { id: 'torque', term: 'Torque', def: 'Twisting force. For caps, it is measured in newton-meters (N&middot;m). Capping torque runs from about 0.5 to 25 N&middot;m, depending on the cap.' },
    { id: 'insert', term: 'Chuck Insert', def: 'The rubber, urethane, or plastic lining inside a chuck that touches the cap. It wears out and gets replaced, often every 2 to 5 million caps.' },
    { id: 'knurling', term: 'Knurling', def: 'The small ridges on the side of a cap. The chuck insert grips these. If the insert does not match the ridges, the cap slips or gets <a href="/troubleshooting/#scuffing">scuffed</a>.' },
    { id: 'slip-torque', term: 'Slip Torque', def: 'The torque where the headset clutch lets go and stops turning the cap. It must be higher than the target torque but lower than the torque that would break the cap.' },
    { id: 'static-torque', term: 'Static Torque (Removal Torque)', def: 'The torque needed to start opening a cap after it has sat for a while. It is often 10 to 30% lower than the torque used to put the cap on, because the liner settles. This is the main number checked in quality audits.' },
    { id: 'cv', term: 'CV% (Torque Spread)', def: 'Coefficient of variation. It shows how much torque changes from cap to cap. Lower is better. Most lines aim for 5% or less. Fast rotary lines aim for 3% or less.' },
    { id: 'cpm', term: 'CPM', def: 'Caps (or containers) per minute. A measure of line speed. The fastest lines run about 1,200 CPM.' },
    { id: 'hysteresis', term: 'Hysteresis Coupling', def: 'A magnetic clutch. Magnets pass turning force across a gap without touching. When the load gets too high, the magnets slip. Used in <a href="/capping-headsets/#magnetic">magnetic capping headsets</a>.' },
    { id: 'top-load', term: 'Top Load', def: 'How hard the chuck pushes down on the top of the cap, measured in newtons (N). It presses the liner against the bottle to make a seal. Too much bends thin caps. Too little gives a weak seal.' },
    { id: 'liner', term: 'Liner', def: 'The seal inside a cap. It can be a separate disc (like a foil induction liner) or a seal molded into the cap. The liner type changes how much torque and top load you need.' },
    { id: 'thread-pitch', term: 'Thread Pitch', def: 'The distance from one thread to the next, in millimeters. Drink caps run from 3.0 to 6.35 mm (see <a href="https://www.isbt.com/resources/isbt-threadspecs" rel="noopener" target="_blank">ISBT threadspecs</a>). Pitch sets how many turns it takes to fully seat the cap.' },
    { id: 'bridge-count', term: 'Bridge Count (Tamper Band)', def: 'The number of small plastic bridges that hold the tamper band to the cap, usually 6 to 12. They should break when the customer opens the bottle, not <a href="/troubleshooting/#te-bands">during capping</a>.' },
    { id: 'closure-ovalization', term: 'Cap Ovalization', def: 'When a round cap gets squeezed into an oval. Causes include too much chuck grip, bad storage, or molding problems. Oval caps cross-thread and seal badly. The limit is often &plusmn;0.2 mm from the normal width, per the cap maker.' },
    { id: 'ropp', term: 'ROPP', def: 'Roll-on pilfer-proof. An aluminum cap that has no threads until the capping head rolls them into the metal. Used on spirits, wine, and olive oil. See <a href="/capping-headsets/#ropp">ROPP headsets</a>.' },
    { id: 'pco-1881', term: 'PCO 1881', def: 'A common 28 mm bottle neck finish for soft drinks and water, published in the <a href="https://www.isbt.com/resources/isbt-threadspecs" rel="noopener" target="_blank">ISBT threadspecs</a>. Tethered versions are required in the EU.' },
    { id: '29-25', term: '29/25', def: 'A bottle neck finish with a 29 mm thread diameter and a 25 mm inside diameter. Common on still water because it uses less plastic than older finishes.' },
    { id: 'vacuum-chuck', term: 'Vacuum Chuck', def: 'A chuck that holds the cap with suction instead of squeezing it. Used for thin or light caps. See <a href="/chuck-types/#vacuum">vacuum cap chucks</a>.' },
];
---

<BaseLayout
    title="Capping Chuck Glossary: Torque, Knurling, Slip Torque, and More"
    description="Plain-English definitions of capping terms: capping chuck, headset, torque, slip torque, CV%, knurling, top load, liner, ROPP, PCO 1881, 29/25, and more."
    canonical="https://cappingchucks.com/glossary/"
    ogTitle="Capping Glossary | CappingChucks.com"
    ogDescription="Capping terms in plain English: torque, slip torque, knurling, top load, ROPP, PCO 1881, 29/25, and more."
    breadcrumb="Glossary"
>
    <PageHero
        title="Capping Glossary"
        crumb="Glossary"
        answerLabel="What's here"
        image={technicalBlueprint}
        alt="Engineering blueprint with compass and pencil showing cross-section drawings of machined components"
        caption="Technical drawing of machined parts. Photo: Pexels"
    >
        <p>Plain definitions for the words used around <a href="/chuck-types/">capping chucks</a> and <a href="/capping-headsets/">headsets</a>. Each one keeps the real numbers.</p>
    </PageHero>

    <main>
        <section class="section">
            <div class="wrap prose-col">
                <dl class="gloss">
                    {terms.map((t) => (
                        <div id={t.id}>
                            <dt>{t.term}</dt>
                            <dd set:html={t.def} />
                        </div>
                    ))}
                </dl>
                <div class="note">
                    <strong>Testing tip:</strong> Use the cap maker's current torque test method plus any customer or legal rules. <a href="https://store.astm.org/d2063_d2063m-24.html" rel="noopener" target="_blank">ASTM D2063</a> covers how to measure torque on threaded caps.
                </div>
            </div>
        </section>

        <section id="resources" class="section section-alt">
            <div class="wrap prose-col">
                <span class="kicker kicker-blue">Resources</span>
                <h2>Standards and groups</h2>
                <ul class="space-y-3">
                    <li><a href="https://www.isbt.com/" rel="noopener" target="_blank">ISBT</a>: International Society of Beverage Technologists. Publishes the <a href="https://www.isbt.com/resources/isbt-threadspecs" rel="noopener" target="_blank">threadspecs</a> for PCO 1881, 1810, and other finishes.</li>
                    <li><a href="https://www.pmmi.org/" rel="noopener" target="_blank">PMMI</a>: The trade group for packaging machine makers.</li>
                    <li><a href="https://store.astm.org/d2063_d2063m-24.html" rel="noopener" target="_blank">ASTM D2063</a>: Test methods for torque on threaded caps (2024 edition).</li>
                    <li><a href="https://www.ecfr.gov/current/title-16/chapter-II/subchapter-E/part-1700" rel="noopener" target="_blank">16 CFR Part 1700</a>: U.S. rules for child-resistant packaging.</li>
                    <li><a href="https://eur-lex.europa.eu/eli/dir/2019/904/oj" rel="noopener" target="_blank">EU Directive 2019/904</a>: The Single-Use Plastics Directive, which requires tethered caps on some drink bottles.</li>
                </ul>
            </div>
        </section>

        <section class="section">
            <div class="wrap">
                <h2>Keep reading</h2>
                <ul class="related">
                    <li><a href="/chuck-types/">Capping chuck types</a></li>
                    <li><a href="/capping-headsets/">Magnetic capping headsets</a></li>
                    <li><a href="/troubleshooting/">Troubleshooting</a></li>
                </ul>
            </div>
        </section>
    </main>
</BaseLayout>
