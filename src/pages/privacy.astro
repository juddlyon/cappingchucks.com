---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
    title="Privacy Policy | CappingChucks.com"
    description="What CappingChucks.com does with visitor information: no analytics, no trackers, no forms. Hosting by Netlify and Cloudflare."
    canonical="https://cappingchucks.com/privacy/"
    breadcrumb="Privacy"
>
    <PageHero title="Privacy Policy" crumb="Privacy" answerLabel="Short version">
        <p>This site doesn't use analytics, ad trackers, cookies, forms, or accounts. Our hosts may log basic connection data to deliver and protect the site.</p>
    </PageHero>

    <main>
        <section id="collected" class="section">
            <div class="wrap prose-col">
                <span class="kicker">Data</span>
                <h2>Information this site collects</h2>
                <p>The site code has no analytics, ad trackers, contact form, sign-up, or server-side data collection. Fonts, images, and styles are served from this site, not loaded from a third-party service.</p>
            </div>
        </section>

        <section id="hosting" class="section section-alt">
            <div class="wrap prose-col">
                <span class="kicker kicker-blue">Hosting</span>
                <h2>Hosting and outside links</h2>
                <p>The site is hosted by <a href="https://www.netlify.com/privacy/" rel="noopener" target="_blank">Netlify</a>. Its domain runs through <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener" target="_blank">Cloudflare</a>. Both may process connection data, such as IP addresses and request logs, to deliver and protect the site. Their own policies say how long they keep it.</p>
                <p>Links to makers, standards bodies, and regulators take you to outside sites with their own policies. The contact email link opens your mail app. Nothing is sent unless you send it.</p>
            </div>
        </section>

        <section id="changes" class="section">
            <div class="wrap prose-col">
                <span class="kicker kicker-green">Changes</span>
                <h2>Changes to this notice</h2>
                <p>If we add measurement or any data collection, we will update this notice first. It will say what data is collected, why, by which provider, and how long it is kept. Last updated October 2, 2026.</p>
                <p>Questions? See <a href="/contact/">Contact</a>.</p>
            </div>
        </section>
    </main>
</BaseLayout>
