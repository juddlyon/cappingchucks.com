---
import { SEO } from 'astro-seo';
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    canonical?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogType?: string;
    schemaType?: 'WebPage' | 'TechArticle';
    breadcrumb?: string;
}

const {
    title,
    description,
    canonical = 'https://cappingchucks.com/',
    ogTitle,
    ogDescription,
    ogType = 'website',
    schemaType = 'WebPage',
    breadcrumb,
} = Astro.props;

const pageSchema: Record<string, unknown> = {
    "@context": "https://schema.org",
    "@type": schemaType,
    "name": title,
    "description": description,
    "url": canonical,
    "publisher": {
        "@type": "Organization",
        "name": "CappingChucks.com",
        "url": "https://cappingchucks.com/"
    },
};

if (schemaType === 'TechArticle') {
    pageSchema["author"] = { "@type": "Organization", "name": "CappingChucks.com" };
    pageSchema["mainEntityOfPage"] = canonical;
}

const breadcrumbSchema = breadcrumb ? {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://cappingchucks.com/"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": breadcrumb,
            "item": canonical
        }
    ]
} : null;

const navItems = [
    { href: '/chuck-types/', label: 'Chuck Types' },
    { href: '/capping-headsets/', label: 'Headsets' },
    { href: '/capping-machines/', label: 'Cappers' },
    { href: '/cap-torque/', label: 'Torque' },
    { href: '/cap-sizes/', label: 'Cap Sizes' },
    { href: '/troubleshooting/', label: 'Troubleshooting' },
    { href: '/glossary/', label: 'Glossary' },
];
const footerLinks = [
    { href: '/', label: 'Capping chucks' },
    { href: '/chuck-types/', label: 'Capping chuck types' },
    { href: '/capping-headsets/', label: 'Capping headsets' },
    { href: '/capping-machines/', label: 'Capping machine types' },
    { href: '/cap-torque/', label: 'Cap torque guide' },
    { href: '/cap-sizes/', label: 'Cap and neck finish sizes' },
    { href: '/ropp-capping/', label: 'ROPP capping' },
    { href: '/troubleshooting/', label: 'Troubleshooting' },
    { href: '/oem-compatibility/', label: 'OEM compatibility' },
    { href: '/glossary/', label: 'Glossary' },
];
const path = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <SEO
        title={title}
        description={description}
        canonical={canonical}
        openGraph={{
            basic: {
                title: ogTitle || title,
                type: ogType,
                url: canonical,
                image: 'https://cappingchucks.com/og-image.png',
            },
            optional: {
                description: ogDescription || description,
                siteName: 'CappingChucks.com',
            },
        }}
        twitter={{
            card: 'summary_large_image',
            title: ogTitle || title,
            description: ogDescription || description,
            image: 'https://cappingchucks.com/og-image.png',
        }}
        extend={{
            meta: [],
        }}
    />

    <!-- Schema.org structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    <!-- Fonts (self-hosted by Astro, with metric-matched fallbacks) -->
    <Font cssVariable="--font-jost" preload={[{ weight: '800' }]} />
    <Font cssVariable="--font-nunito" preload={[{ weight: '400' }]} />
</head>
<body>
    <header class="site-header">
        <nav class="wrap" aria-label="Primary navigation">
            <a href="/" class="logo" aria-label="CappingChucks.com home"><img src="/favicon.svg" alt="" class="logo-mark" width="32" height="32">CappingChucks</a>
            <ul class="nav-links">
                {navItems.map((item) => (
                    <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
                ))}
            </ul>
        </nav>
        <script is:inline>
            (function () {
                var cur = document.querySelector('.nav-links [aria-current="page"]');
                if (cur) cur.closest('.nav-links').scrollLeft = cur.parentElement.offsetLeft - 16;
            })();
        </script>
    </header>

    <slot />

    <footer class="site-footer">
        <div class="wrap flex flex-wrap justify-between gap-4">
            <div>
                <p class="font-bold text-lg">CappingChucks.com</p>
                <p>A plain-English guide to capping chucks and headsets.</p>
            </div>
            <nav aria-label="Footer navigation">
                <ul class="footer-links">
                    {footerLinks.map((item) => (
                        <li><a href={item.href}>{item.label}</a></li>
                    ))}
                </ul>
            </nav>
            <p>&copy; 2026 CappingChucks.com<br>All trademarks belong to their owners.</p>
        </div>
    </footer>
</body>
</html>
